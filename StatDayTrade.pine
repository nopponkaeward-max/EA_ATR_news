//@version=6
// ============================================================================
//  FeeInvest_StatDayTrade — Statistical Day-Trade Model  (Pine v6 · overlay)
//  + Luxe Stat Tables ชุดเดียวกับ ATR_News_Straddle:
//    Main / By-Day / Daily Log / Monthly / Settings Summary
//    และคงตาราง Risk:Reward (Expectancy · PF · $P/L · Verdict) ไว้ตามเดิม
// ----------------------------------------------------------------------------
//  แนวคิดเชิงสถิติ:
//   1) Anchored VWAP รายวัน = ค่ากลาง (mean) ของราคาถ่วงน้ำหนักปริมาณในวันนั้น
//   2) σ-bands = ส่วนเบี่ยงเบนมาตรฐานรอบค่ากลาง (±1σ, ±2σ, ±3σ)
//   3) Z-score = (price − mean) / σ  → ราคาห่างจากค่ากลางกี่ SD
//   ENTRY 2 โหมด:
//     • Mean-Reversion : ราคาแตะ ±entryZ σ แล้วแท่งกลับตัว → สวนกลับหา mean
//     • Breakout       : ราคาปิดทะลุ ±brkZ σ พร้อม σ ขยายตัว → ตามโมเมนตัม
//   EXIT เชิงสถิติ:
//     • SL = ATR × mult · TP = 1R × R:R · ปิดสิ้นวัน (EOD) · จำกัด 1 ไม้/วัน
//   การนับ R (ปรับปรุง):
//     • TP → +ระยะTP/ระยะSL · SL → −1R · EOD → mark-to-market เทียบ 1R
//     • ใช้ Lower TF ตัดสินว่า TP หรือ SL โดนก่อน เมื่อแท่งเดียวครอบทั้งคู่
// ============================================================================

indicator("FeeInvest_StatDayTrade", shorttitle="Stat_DayTrade", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ==========================================
// --- 1. INPUTS ---
// ==========================================

grpStat = "▶ Statistical Model"
sdLen        = input.int(20,   title="σ Lookback (แท่ง คำนวณ SD)", minval=5,  maxval=200, group=grpStat, tooltip="จำนวนแท่งย้อนหลังที่ใช้คำนวณ standard deviation รอบค่ากลาง")
useVWAPanchor= input.bool(true, title="Anchor σ-bands ที่ VWAP รายวัน", group=grpStat, tooltip="เปิด = ใช้ Anchored VWAP เป็นค่ากลาง (แนะนำ)\nปิด = ใช้ SMA(sdLen) เป็นค่ากลางแทน")
entryModeStat= input.string("Mean-Reversion", title="โหมดเข้า", options=["Mean-Reversion", "Breakout"], group=grpStat, tooltip="Mean-Reversion: สวนกลับที่ ±2σ (โอกาสกลับสูงถ้าไม่มีเทรนด์แรง)\nBreakout: ตามโมเมนตัมเมื่อปิดนอก ±1σ พร้อมความผันผวนขยาย")
entryZ       = input.float(2.0, title="Z เข้า Mean-Reversion (σ)", minval=0.5, maxval=4.0, step=0.1, group=grpStat, tooltip="ราคาต้องห่างจากค่ากลางกี่ SD ถึงจะพิจารณาสวนกลับ (มาตรฐาน 2σ ≈ 95%)")
brkZ         = input.float(1.0, title="Z เข้า Breakout (σ)", minval=0.3, maxval=3.0, step=0.1, group=grpStat, tooltip="ราคาปิดต้องทะลุกี่ SD ถึงจะเข้าไม้ breakout")
volExpand    = input.float(1.05,title="ต้องมี σ ขยายตัว ≥ (เท่า)", minval=1.0, maxval=2.0, step=0.01, group=grpStat, tooltip="Breakout: σ ปัจจุบันต้อง ≥ σ ก่อนหน้า × ค่านี้ (กรอง volatility clustering)")

grpSess = "▶ Day-Trade Session"
sessTime    = input.session("0000-2359", title="ช่วงเวลาเทรด (Session)", group=grpSess, tooltip="อนุญาตเปิดไม้เฉพาะในช่วงนี้ (เวลาโบรก) — BTC 24 ชม. ใช้ค่าเริ่มต้นได้")
oneTradeDay = input.bool(true, title="จำกัด 1 ไม้ / วัน", group=grpSess, tooltip="เปิดได้วันละ 1 ไม้ (วินัย day-trade)")
closeEOD    = input.bool(true, title="ปิดไม้สิ้นวัน (EOD)", group=grpSess, tooltip="บังคับปิดออเดอร์ที่ค้างเมื่อจบวัน (mark-to-market เป็น R)")

grpDays = "▶ Trade Days"
tSun = input.bool(true,  title="Sun", group=grpDays, inline="d1")
tMon = input.bool(true,  title="Mon", group=grpDays, inline="d1")
tTue = input.bool(true,  title="Tue", group=grpDays, inline="d1")
tWed = input.bool(true,  title="Wed", group=grpDays, inline="d2")
tThu = input.bool(true,  title="Thu", group=grpDays, inline="d2")
tFri = input.bool(true,  title="Fri", group=grpDays, inline="d2")
tSat = input.bool(true,  title="Sat", group=grpDays, inline="d3")

grpRisk = "▶ Risk / Exit"
atrLen   = input.int(14,   title="ATR Period (SL)", minval=2, maxval=100, group=grpRisk)
atrMult  = input.float(1.5,title="SL = ATR ×", minval=0.2, maxval=10.0, step=0.1, group=grpRisk, tooltip="ระยะ Stop Loss = ATR × ตัวคูณ (ปรับตามความผันผวนจริง)")
rrRatio  = input.float(1.5,title="TP = R:R (1 : x)", minval=0.2, maxval=10.0, step=0.1, group=grpRisk, tooltip="ระยะ TP = 1R × ค่านี้ เช่น 1.5 = เสี่ยง 1 ได้ 1.5")
riskUSD  = input.float(100.0, title="Risk / 1R ($)", minval=0.01, group=grpRisk, tooltip="เงินที่ยอมเสียต่อ 1R ใช้คำนวณ $ กำไร/ขาดทุนในตาราง")
lotRatio = input.float(100.0, title="1 Lot Ratio ($/price)", minval=0.001, group=grpRisk, tooltip="มูลค่า $ ต่อ 1 หน่วยราคา ต่อ 1 lot — เช่น XAUUSD = 100 (ใช้แสดง Size บนป้ายเข้าไม้)")
ltfRes   = input.timeframe("1", title="Lower TF for TP/SL check", group=grpRisk, tooltip="ใช้แท่ง TF ย่อยตัดสินว่า TP หรือ SL โดนก่อน เมื่อแท่งเดียวครอบทั้งคู่")

ltfHigh = request.security_lower_tf(syminfo.tickerid, ltfRes, high)
ltfLow  = request.security_lower_tf(syminfo.tickerid, ltfRes, low)

// --- Display & Stats ---
showBands         = input.bool(true,  title=" Show σ-bands + VWAP",           group="Display & Stats", display=display.none)
showSignals       = input.bool(true,  title=" Show Entry/Exit Labels",        group="Display & Stats", display=display.none)
showTradePath     = input.bool(true,  title=" Show Trade Path Lines",         group="Display & Stats", display=display.none)
showRRtable       = input.bool(true,  title=" Show Risk:Reward Table",        group="Display & Stats", display=display.none)
showStatsTable    = input.bool(true,  title=" Show Stats Table (Main)",       group="Display & Stats", display=display.none)
showDayTable      = input.bool(false, title=" Show By-Day Table (Sun–Sat)",   group="Display & Stats", display=display.none)
showDailyTable    = input.bool(false, title=" Show Daily Log (Specific Month)", group="Display & Stats", display=display.none)
showMonthlyTable  = input.bool(true,  title=" Show Monthly Table",            group="Display & Stats", display=display.none)
showSettingsTable = input.bool(true,  title=" Show Settings Summary Table",   group="Display & Stats", display=display.none)
limitDrawDays     = input.bool(true,  title=" Limit Drawings to Stat Period", group="Display & Stats", display=display.none)

showSun = input.bool(true,  title="  ├ Sun", group="Display & Stats", display=display.none)
showMon = input.bool(true,  title="  ├ Mon", group="Display & Stats", display=display.none)
showTue = input.bool(true,  title="  ├ Tue", group="Display & Stats", display=display.none)
showWed = input.bool(true,  title="  ├ Wed", group="Display & Stats", display=display.none)
showThu = input.bool(true,  title="  ├ Thu", group="Display & Stats", display=display.none)
showFri = input.bool(true,  title="  ├ Fri", group="Display & Stats", display=display.none)
showSat = input.bool(true,  title="  └ Sat", group="Display & Stats", display=display.none)

int enabledDayCnt = (showSun?1:0)+(showMon?1:0)+(showTue?1:0)+(showWed?1:0)+(showThu?1:0)+(showFri?1:0)+(showSat?1:0)

rrTablePos        = input.string("Bottom Right",  title="▶ Risk:Reward Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)
mainTablePos      = input.string("Middle Right",  title="▶ Stats (Main) Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)
monthlyTablePos   = input.string("Bottom Center", title="▶ Monthly Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)
dailyTablePos     = input.string("Middle Left",   title="▶ Daily Log Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)
dayTablePos       = input.string("Top Right",     title="▶ By-Day Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)
settingsTablePos  = input.string("Bottom Left",   title="▶ Settings Table Position",
                   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
                   group="Display & Stats", display=display.none)

statMode    = input.string("2. Last N Months", title="▶ Stat Period Mode",
             options=["1. Last N Days","2. Last N Months","3. Specific Month"],
             group="Display & Stats", display=display.none)
statDays    = input.int(30,  title="[Mode 1] Days",   minval=1, maxval=365, group="Display & Stats", display=display.none)
statMonths  = input.int(3,   title="[Mode 2] Months", minval=1, maxval=12,  group="Display & Stats", display=display.none)
statTargetM = input.string("August", title="[Mode 3] Month",
             options=["January","February","March","April","May","June",
                      "July","August","September","October","November","December"],
             group="Display & Stats", display=display.none)
statTargetY = input.int(0, title="[Mode 3] Year (0 = current)",
             minval=0, maxval=2100, group="Display & Stats", display=display.none)

// --- Timezone (ใช้ตีความวัน/เดือนของสถิติ) ---
useChartTz = input.bool(true, title=" Use Chart Timezone (Exchange)", group="Timezone",
             tooltip="ON = ใช้โซนเวลาของ Exchange (syminfo.timezone) ตรงกับเวลาบนกราฟเมื่อตั้ง Chart Timezone = Exchange\nOFF = ใช้ UTC + offset ด้านล่างแทน", display=display.none)
tzIncr     = input.int(0, title="UTC (+/-)  [ใช้เมื่อปิด Use Chart Timezone]", group="Timezone", display=display.none)

// ==========================================
// --- 2. UTILS ---
// ==========================================

var string tzStr = useChartTz ? syminfo.timezone
                              : str.format("UTC{0}{1}", tzIncr >= 0 ? "+" : "-", math.abs(tzIncr))

f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

int curYear = year(timenow, tzStr)

f_monthNum(string nm) =>
    switch nm
        "January"   => 1
        "February"  => 2
        "March"     => 3
        "April"     => 4
        "May"       => 5
        "June"      => 6
        "July"      => 7
        "August"    => 8
        "September" => 9
        "October"   => 10
        "November"  => 11
        => 12

f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for b = 1 to 10
        s += b <= filled ? "▰" : "▱"
    s

int targetMonthNum = f_monthNum(statTargetM)
int actualTargetY  = statTargetY == 0 ? curYear : statTargetY
int currentTotalM  = curYear * 12 + month(timenow, tzStr)

// อยู่ในช่วงสถิติที่เลือกหรือไม่ (ใช้ทั้งตาราง + cleanup รูปวาด)
f_inPeriod(int t) =>
    bool valid = false
    if statMode == "1. Last N Days"
        int refT   = timenow - statDays * 86400000
        int cutoff = year(refT,tzStr)*10000 + month(refT,tzStr)*100 + dayofmonth(refT,tzStr)
        int tDay   = year(t,tzStr)*10000 + month(t,tzStr)*100 + dayofmonth(t,tzStr)
        valid := tDay >= cutoff
    else if statMode == "2. Last N Months"
        valid := (year(t,tzStr)*12 + month(t,tzStr)) >= (currentTotalM - statMonths + 1)
    else
        valid := month(t,tzStr) == targetMonthNum and year(t,tzStr) == actualTargetY
    valid

// ==========================================
// --- 3. DRAWING REGISTRATION HELPERS ---
// ==========================================

var array<line>  regLines    = array.new<line>()
var array<int>   regLineTime = array.new_int()
var array<label> regLabels   = array.new<label>()
var array<int>   regLabelTime= array.new_int()

regLine(line l) =>
    if not na(l)
        array.push(regLines,    l)
        array.push(regLineTime, time)
        if array.size(regLines) > 600
            line.delete(array.shift(regLines))
            array.shift(regLineTime)

regLabel(label lb) =>
    if not na(lb)
        array.push(regLabels,    lb)
        array.push(regLabelTime, time)
        if array.size(regLabels) > 600
            label.delete(array.shift(regLabels))
            array.shift(regLabelTime)

// ==========================================
// --- 4. RESULT ARRAYS ---
// ==========================================

var array<bool>  resIsWin   = array.new_bool()
var array<float> resTradeRR = array.new_float()
var array<int>   resTime    = array.new_int()
var array<float> resTpPts   = array.new_float()   // ระยะที่ราคาวิ่งจริง (|exit − entry|)

// ==========================================
// --- 5. STATISTICAL CORE (VWAP + σ + Z-score) ---
// ==========================================

bool newDay = ta.change(time("D")) != 0

// Anchored VWAP (reset รายวัน)
var float cumPV = na
var float cumV  = na
if newDay
    cumPV := hlc3 * volume
    cumV  := volume
else
    cumPV := nz(cumPV) + hlc3 * volume
    cumV  := nz(cumV)  + volume
float vwap = cumV > 0 ? cumPV / cumV : hlc3

// ค่ากลาง (mean) : เลือก VWAP หรือ SMA
float mean = useVWAPanchor ? vwap : ta.sma(close, sdLen)
float sd   = ta.stdev(close, sdLen)
float sdPrev = sd[1]

// σ-bands
float up1 = mean + sd,       dn1 = mean - sd
float up2 = mean + sd * 2.0, dn2 = mean - sd * 2.0
float up3 = mean + sd * 3.0, dn3 = mean - sd * 3.0

// Z-score ปัจจุบัน
float zscore = sd > 0 ? (close - mean) / sd : 0.0

float atr = ta.atr(atrLen)

// ==========================================
// --- 6. PLOT BANDS ---
// ==========================================

color cBull   = color.rgb(0, 210, 160)
color cBear   = color.rgb(255, 82, 82)
color cVWAP   = color.rgb(212, 175, 55)
color cBand1  = color.rgb(102, 208, 255)
color cBand2  = color.rgb(255, 152, 0)

plot(showBands ? mean : na, "VWAP/Mean", color=cVWAP, linewidth=2)
p_up1 = plot(showBands ? up1 : na, "+1σ", color=color.new(cBand1, 40))
p_dn1 = plot(showBands ? dn1 : na, "-1σ", color=color.new(cBand1, 40))
p_up2 = plot(showBands ? up2 : na, "+2σ", color=color.new(cBand2, 30))
p_dn2 = plot(showBands ? dn2 : na, "-2σ", color=color.new(cBand2, 30))
plot(showBands ? up3 : na, "+3σ", color=color.new(cBear, 55), style=plot.style_circles)
plot(showBands ? dn3 : na, "-3σ", color=color.new(cBull, 55), style=plot.style_circles)
fill(p_up1, p_up2, color=color.new(cBand2, 92))
fill(p_dn1, p_dn2, color=color.new(cBand2, 92))

// ==========================================
// --- 7. SESSION / DAY FILTER ---
// ==========================================

bool inSession = not na(time(timeframe.period, sessTime))
int dow = dayofweek
bool dayOK = switch dow
    dayofweek.sunday    => tSun
    dayofweek.monday    => tMon
    dayofweek.tuesday   => tTue
    dayofweek.wednesday => tWed
    dayofweek.thursday  => tThu
    dayofweek.friday    => tFri
    => tSat

var int tradesToday = 0
if newDay
    tradesToday := 0

// ==========================================
// --- 8. ENTRY SIGNALS (statistical) ---
// ==========================================

// Mean-Reversion: แตะ ±entryZ σ แล้วแท่งกลับตัว
bool mrLong  = entryModeStat == "Mean-Reversion" and zscore <= -entryZ and close > open
bool mrShort = entryModeStat == "Mean-Reversion" and zscore >=  entryZ and close < open
// Breakout: ปิดทะลุ ±brkZ σ พร้อม σ ขยาย
bool boLong  = entryModeStat == "Breakout" and zscore >=  brkZ and close > open and sd >= sdPrev * volExpand
bool boShort = entryModeStat == "Breakout" and zscore <= -brkZ and close < open and sd >= sdPrev * volExpand

bool rawLong  = mrLong  or boLong
bool rawShort = mrShort or boShort

// ==========================================
// --- 9. TRADE STATE MACHINE (1 position) ---
// ==========================================

var bool  inTrade   = false
var bool  posIsBuy  = false
var float posEntry  = na
var float posSL     = na
var float posTP     = na
var int   posBar    = na
var int   posTime   = na

// ---- ปิดไม้ + บันทึกผล + วาด visual แบบ ATR_News_Straddle ----
f_closeTrade(float exitPx, float rVal) =>
    bool isWin = rVal > 0
    array.push(resIsWin,   isWin)
    array.push(resTradeRR, rVal)
    array.push(resTime,    posTime)
    array.push(resTpPts,   math.abs(exitPx - posEntry))
    if array.size(resIsWin) > 5000
        array.shift(resIsWin)
        array.shift(resTradeRR)
        array.shift(resTime)
        array.shift(resTpPts)
    color exitCol = isWin ? color.new(color.green, 20) : color.new(color.red, 20)
    color pathCol = isWin ? color.new(color.green, 60) : color.new(color.red, 60)
    string rStr   = (rVal >= 0 ? "+" : "") + str.tostring(rVal, "#.##") + "R"
    if showSignals
        regLabel(label.new(x=bar_index, y=exitPx,
                           text=(isWin ? "Win" : "Loss") + "\n" + rStr,
                           color=exitCol, textcolor=color.white,
                           style=posIsBuy ? label.style_label_down : label.style_label_up,
                           size=size.small))
        regLine(line.new(x1=bar_index-3, y1=exitPx, x2=bar_index+3, y2=exitPx,
                         color=isWin ? color.green : color.red, width=2))
    if showTradePath
        regLine(line.new(x1=posBar, y1=posEntry, x2=bar_index, y2=exitPx,
                         color=pathCol, width=1, style=line.style_dashed))
    inTrade  := false
    posEntry := na
    posSL    := na
    posTP    := na

bool canEnter = inSession and dayOK and not inTrade and barstate.isconfirmed and (not oneTradeDay or tradesToday < 1)

// --- OPEN (market เมื่อแท่งปิด) ---
if canEnter and (rawLong or rawShort)
    posIsBuy := rawLong
    posEntry := close
    float oneR = atr * atrMult
    posSL := posIsBuy ? posEntry - oneR : posEntry + oneR
    posTP := posIsBuy ? posEntry + oneR * rrRatio : posEntry - oneR * rrRatio
    posBar  := bar_index
    posTime := time
    inTrade := true
    tradesToday += 1
    // ---- entry visuals (แบบ ATR_News_Straddle) ----
    if showSignals
        color entCol = posIsBuy ? color.blue : color.red
        regLabel(label.new(x=bar_index, y=posEntry, text="",
                           style=label.style_circle, color=color.new(entCol, 55), size=size.large))
        regLine(line.new(x1=bar_index, y1=posEntry, x2=bar_index, y2=posTP,
                         color=color.new(color.green, 70), width=1, style=line.style_arrow_right))
        regLine(line.new(x1=bar_index, y1=posEntry, x2=bar_index, y2=posSL,
                         color=color.new(color.red, 70), width=1, style=line.style_arrow_right))
        float lotSz = oneR > 0 ? riskUSD / (oneR * lotRatio) : na
        string info = (posIsBuy ? "LONG" : "SHORT") + " · Z=" + str.tostring(zscore, "#.##") +
                      (na(lotSz) ? "" : "\nSize " + str.tostring(lotSz, "#.###") + " lot") +
                      "\nSL " + str.tostring(oneR, format.mintick) + " · TP " + str.tostring(oneR * rrRatio, format.mintick)
        regLabel(label.new(x=bar_index, y=posEntry, text=info,
                           color=color.new(color.black, 60), textcolor=color.new(color.white, 15),
                           style=posIsBuy ? label.style_label_up : label.style_label_down, size=size.small))

// --- MANAGE / CLOSE (เมื่อแท่งปิดยืนยันแล้ว หลังแท่งที่เข้า) ---
if inTrade and barstate.isconfirmed and bar_index > posBar
    bool hitTP = posIsBuy ? high >= posTP : low  <= posTP
    bool hitSL = posIsBuy ? low  <= posSL : high >= posSL
    bool eodC  = closeEOD and newDay
    if hitTP or hitSL or eodC
        float oneR = math.abs(posEntry - posSL)
        float rVal = 0.0
        float exitPx = close
        if hitTP or hitSL
            // โดนทั้งคู่ในแท่งเดียว → ใช้ Lower TF ตัดสินว่าอะไรโดนก่อน
            bool tpFirst = hitTP
            if hitTP and hitSL
                int ltfSize = array.size(ltfHigh)
                if ltfSize > 0
                    bool resolved = false
                    for j = 0 to ltfSize - 1
                        if not resolved
                            float lh = array.get(ltfHigh, j)
                            float ll = array.get(ltfLow, j)
                            bool ltfTP = posIsBuy ? lh >= posTP : ll <= posTP
                            bool ltfSL = posIsBuy ? ll <= posSL : lh >= posSL
                            if ltfTP and not ltfSL
                                tpFirst := true
                                resolved := true
                            else if ltfSL and not ltfTP
                                tpFirst := false
                                resolved := true
                            else if ltfTP and ltfSL
                                tpFirst := math.abs(open - posTP) < math.abs(open - posSL)
                                resolved := true
            if tpFirst
                rVal   := oneR > 0 ? math.abs(posTP - posEntry) / oneR : rrRatio
                exitPx := posTP
            else
                rVal   := -1.0
                exitPx := posSL
        else
            // EOD: mark-to-market เป็น R จากราคาปิดจริงเทียบ entry
            float diff = posIsBuy ? (exitPx - posEntry) : (posEntry - exitPx)
            rVal := oneR > 0 ? diff / oneR : 0.0
        f_closeTrade(exitPx, rVal)

// ---- trigger markers ----
plotshape(showSignals and rawLong  and barstate.isconfirmed, title="Long Signal",  style=shape.triangleup,
          location=location.belowbar, color=color.new(cBull, 0), size=size.tiny)
plotshape(showSignals and rawShort and barstate.isconfirmed, title="Short Signal", style=shape.triangledown,
          location=location.abovebar, color=color.new(cBear, 0), size=size.tiny)

// ---- Plot เส้น TP/SL/Entry ของไม้ที่ยังเปิดอยู่ ----
plot(inTrade ? posTP    : na, "Open TP",    color=color.new(color.green, 30), linewidth=1, style=plot.style_linebr)
plot(inTrade ? posSL    : na, "Open SL",    color=color.new(color.red,   30), linewidth=1, style=plot.style_linebr)
plot(inTrade ? posEntry : na, "Open Entry", color=color.new(color.orange,30), linewidth=1, style=plot.style_linebr)

// ==========================================
// --- 10. CLEANUP (Limit Drawings) ---
// ==========================================

if limitDrawDays and barstate.islast
    if array.size(regLines) > 0
        for i = array.size(regLines) - 1 to 0
            if not f_inPeriod(array.get(regLineTime, i))
                line.delete(array.get(regLines, i))
                array.remove(regLines, i)
                array.remove(regLineTime, i)
    if array.size(regLabels) > 0
        for i = array.size(regLabels) - 1 to 0
            if not f_inPeriod(array.get(regLabelTime, i))
                label.delete(array.get(regLabels, i))
                array.remove(regLabels, i)
                array.remove(regLabelTime, i)

// ==========================================
// --- 11. LUXE TABLE THEME ---
// ==========================================

color lxGold    = color.rgb(212, 175, 55)
color lxTitleTx = color.rgb(236, 210, 140)
color lxHeadBg  = color.new(color.rgb(26, 32, 52), 6)
color lxSubBg   = color.new(color.rgb(19, 24, 40), 8)
color lxColHd   = color.rgb(150, 160, 182)
color lxRowA    = color.new(color.rgb(13, 17, 28), 14)
color lxRowB    = color.new(color.rgb(22, 28, 46), 14)
color lxRowDim  = color.new(color.rgb(13, 17, 28), 52)
color lxText    = color.rgb(233, 236, 243)
color lxMuted   = color.rgb(128, 138, 158)
color lxDimTx   = color.rgb(90, 98, 116)
color lxGreen   = color.rgb(64, 216, 158)
color lxRed     = color.rgb(250, 118, 118)
color lxAmber   = color.rgb(251, 191, 36)
color lxCyan    = color.rgb(102, 208, 255)
color lxFrame   = color.new(lxGold, 42)
color lxGrid    = color.new(color.rgb(7, 10, 17), 35)
color lxBestBg  = color.new(lxGold, 84)

// ==========================================
// --- 12. TABLE INSTANCES ---
// ==========================================

var table rrTable       = table.new(f_tablePos(rrTablePos),       2, 14,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table statsTable    = table.new(f_tablePos(mainTablePos),     2, 16,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table dayStatsTbl   = table.new(f_tablePos(dayTablePos),      4,  3 + enabledDayCnt,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table dailyStatsTbl = table.new(f_tablePos(dailyTablePos),    6, 34,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table monthlyTbl    = table.new(f_tablePos(monthlyTablePos),  5, statMonths + 3,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table settingsTbl   = table.new(f_tablePos(settingsTablePos), 2, 22,
     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var bool mgRR   = false
var bool mg1    = false
var bool mg2    = false
var bool mg3    = false
var bool mg4    = false
var bool mg5    = false

// ==========================================
// --- 13. PERIOD STRING ---
// ==========================================

string periodStr = switch statMode
    "1. Last N Days"   => "Last " + str.tostring(statDays) + " Days"
    "2. Last N Months" => "Last " + str.tostring(statMonths) + " Months"
    =>                    statTargetM + " " + str.tostring(actualTargetY)

// ==========================================
// --- 14. TABLE: RISK:REWARD (คงของเดิม + กรองตามช่วงสถิติ) ---
// ==========================================

if showRRtable and barstate.islast
    int    nW = 0
    int    nL = 0
    float  sumR = 0.0
    float  grossWinR = 0.0
    float  grossLossR = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            if f_inPeriod(array.get(resTime, i))
                bool  w = array.get(resIsWin, i)
                float r = array.get(resTradeRR, i)
                sumR += r
                if w
                    nW += 1
                    grossWinR += r
                else
                    nL += 1
                    grossLossR += math.abs(r)
    int   total = nW + nL
    float wr    = total > 0 ? nW / total * 100.0 : na
    float avgWinR  = nW > 0 ? grossWinR  / nW : 0.0
    float avgLossR = nL > 0 ? grossLossR / nL : 0.0
    // Expectancy per trade (R) = p_win×avgWin − p_loss×avgLoss
    float pW = total > 0 ? nW / total : 0.0
    float pL = total > 0 ? nL / total : 0.0
    float expR = total > 0 ? pW * avgWinR - pL * avgLossR : na
    float pf   = grossLossR > 0 ? grossWinR / grossLossR : (grossWinR > 0 ? 999.0 : na)
    float netUSD = sumR * riskUSD
    float expUSD = na(expR) ? na : expR * riskUSD

    color wrC  = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color rC   = total == 0 ? lxMuted : sumR > 0 ? lxGreen : sumR < 0 ? lxRed : lxAmber
    color eC   = na(expR) ? lxMuted : expR > 0 ? lxGreen : lxRed
    color pfC  = na(pf) ? lxMuted : pf >= 1.0 ? lxGreen : lxRed
    color usdC = total == 0 ? lxMuted : netUSD > 0 ? lxGreen : netUSD < 0 ? lxRed : lxAmber

    // verdict ความคุ้มค่า
    string verdict = "-"
    color  vC = lxMuted
    if total > 0 and not na(expR)
        if expR > 0 and pf >= 1.3
            verdict := "คุ้ม ✓ (Edge+)"
            vC := lxGreen
        else if expR > 0
            verdict := "พอคุ้ม (Edge บาง)"
            vC := lxAmber
        else
            verdict := "ไม่คุ้ม ✗ (No Edge)"
            vC := lxRed

    table.cell(rrTable, 0, 0, "◆  RISK : REWARD", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(rrTable, 0, 1, entryModeStat + " · 1:" + str.tostring(rrRatio,"#.#") + " · " + periodStr,
               text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(rrTable, 0, 2, "Trades", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(rrTable, 1, 2, total == 0 ? "-" : str.tostring(nW)+"W · "+str.tostring(nL)+"L", text_color=lxText, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(rrTable, 0, 3, "Winrate", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(rrTable, 1, 3, na(wr) ? "-" : str.tostring(wr,"#.#")+"%\n"+f_wrBar(wr), text_color=wrC, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(rrTable, 0, 4, "Avg Win", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(rrTable, 1, 4, nW > 0 ? "+"+str.tostring(avgWinR,"#.##")+"R" : "-", text_color=lxGreen, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(rrTable, 0, 5, "Avg Loss", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(rrTable, 1, 5, nL > 0 ? "-"+str.tostring(avgLossR,"#.##")+"R" : "-", text_color=lxRed, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(rrTable, 0, 6, "Expectancy", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(rrTable, 1, 6, na(expR) ? "-" : (expR>=0?"+":"")+str.tostring(expR,"#.###")+"R", text_color=eC, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(rrTable, 0, 7, "Profit Factor", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(rrTable, 1, 7, na(pf) ? "-" : str.tostring(pf,"#.##"), text_color=pfC, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(rrTable, 0, 8, "Net R", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(rrTable, 1, 8, total == 0 ? "-" : (sumR>=0?"+":"")+str.tostring(sumR,"#.##")+"R", text_color=rC, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(rrTable, 0, 9, "Exp / trade $", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(rrTable, 1, 9, na(expUSD) ? "-" : (expUSD>=0?"+$":"-$")+str.tostring(math.abs(expUSD),"#.##"), text_color=eC, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(rrTable, 0, 10, "Net P/L", text_color=lxText, text_size=size.small, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(rrTable, 1, 10, total == 0 ? "-" : (netUSD>=0?"+$":"-$")+str.tostring(math.abs(netUSD),"#,###.##"), text_color=usdC, text_size=size.normal, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(rrTable, 0, 11, "Verdict", text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(rrTable, 1, 11, verdict, text_color=vC, text_size=size.small, bgcolor=lxSubBg, text_halign=text.align_right)
    if not mgRR
        mgRR := true
        table.merge_cells(rrTable, 0, 0, 1, 0)
        table.merge_cells(rrTable, 0, 1, 1, 1)

// ==========================================
// --- 15. TABLE: MAIN STATS + BY-DAY ---
// ==========================================

if (showStatsTable or showDayTable) and barstate.islast

    int   winCnt  = 0
    int   lossCnt = 0
    int   streak  = 0
    int   maxW    = 0
    int   maxL    = 0
    int   curSS   = 0
    int   maxWS   = 0
    int   maxWE   = 0
    int   maxLS   = 0
    int   maxLE   = 0
    float netR    = 0.0
    float curWR   = 0.0
    float curLR   = 0.0
    float mxWR    = 0.0
    float mxLR    = 0.0
    float curWPts = 0.0
    float curLPts = 0.0
    float mxWPts  = 0.0
    float mxLPts  = 0.0
    int[]   dowWin  = array.new_int(8, 0)
    int[]   dowLoss = array.new_int(8, 0)
    float[] dowNetR = array.new_float(8, 0.0)

    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            if f_inPeriod(t)
                float rrv   = array.get(resTradeRR, i)
                bool  isWin = array.get(resIsWin,   i)
                float pts   = array.get(resTpPts,   i)
                int   dw    = dayofweek(t, tzStr)
                netR += rrv
                if streak == 0
                    curSS := t
                if isWin
                    winCnt  += 1
                    curWR   := streak >= 0 ? curWR   + rrv : rrv
                    curWPts := streak >= 0 ? curWPts + pts : pts
                    if streak < 0
                        curSS := t
                    streak := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW := streak
                        maxWS := curSS
                        maxWE := t
                    mxWR   := math.max(mxWR,  curWR)
                    mxWPts := math.max(mxWPts, curWPts)
                    if dw >= 1 and dw <= 7
                        array.set(dowWin,  dw, array.get(dowWin,  dw) + 1)
                        array.set(dowNetR, dw, array.get(dowNetR, dw) + rrv)
                else
                    lossCnt += 1
                    curLR   := streak <= 0 ? curLR   + rrv : rrv
                    curLPts := streak <= 0 ? curLPts - pts : -pts
                    if streak > 0
                        curSS := t
                    streak := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL := -streak
                        maxLS := curSS
                        maxLE := t
                    mxLR   := math.min(mxLR,  curLR)
                    mxLPts := math.min(mxLPts, curLPts)
                    if dw >= 1 and dw <= 7
                        array.set(dowLoss, dw, array.get(dowLoss, dw) + 1)
                        array.set(dowNetR, dw, array.get(dowNetR, dw) + rrv)

    int   totalCnt = winCnt + lossCnt
    float wr       = totalCnt > 0 ? (winCnt / totalCnt) * 100.0 : na
    color wrCol    = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color netRCol  = totalCnt == 0 ? lxMuted : netR > 0 ? lxGreen : netR < 0 ? lxRed : lxAmber
    string netRStr = totalCnt == 0 ? "-" : (netR > 0 ? "+" : "") + str.tostring(netR, "#.##") + "R"
    string strkStr = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color strkCol  = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted
    string mxWDate = maxW > 0 ? str.tostring(dayofmonth(maxWS,tzStr)) + " " + f_monthShort(month(maxWS,tzStr)) + "–" + str.tostring(dayofmonth(maxWE,tzStr)) + " " + f_monthShort(month(maxWE,tzStr)) : "-"
    string mxLDate = maxL > 0 ? str.tostring(dayofmonth(maxLS,tzStr)) + " " + f_monthShort(month(maxLS,tzStr)) + "–" + str.tostring(dayofmonth(maxLE,tzStr)) + " " + f_monthShort(month(maxLE,tzStr)) : "-"
    string zSub    = entryModeStat == "Mean-Reversion" ? "MR ±" + str.tostring(entryZ, "#.#") + "σ" : "BO ±" + str.tostring(brkZ, "#.#") + "σ"

    if showStatsTable
        table.cell(statsTable, 0, 0,  "◆  STAT DAY-TRADE",       text_color=lxTitleTx, text_size=size.small,  bgcolor=lxHeadBg)
        table.cell(statsTable, 0, 1,  periodStr + "  ·  " + zSub, text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxSubBg)
        table.cell(statsTable, 0, 2,  "Trades",     text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 2,  totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L",
                   text_color=lxText,   text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 3,  "Winrate",    text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 3,  na(wr) ? "-" : str.tostring(wr, "#.#") + "%\n" + f_wrBar(wr),
                   text_color=wrCol,    text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 4,  "Net R",      text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 4,  netRStr,       text_color=netRCol,  text_size=size.normal, bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 5,  "Max Streak", text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 5,  "W" + str.tostring(maxW) + " · L" + str.tostring(maxL),
                   text_color=lxAmber,  text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 6,  " W" + str.tostring(maxW) + " Date", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 6,  mxWDate, text_color=maxW > 0 ? lxGreen : lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 7,  " L" + str.tostring(maxL) + " Date", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 7,  mxLDate, text_color=maxL > 0 ? lxRed : lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 8,  "Max Streak R",   text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 8,  totalCnt == 0 ? "-" : "+" + str.tostring(mxWR, "#.##") + "R · " + str.tostring(mxLR, "#.##") + "R",
                   text_color=lxAmber,  text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 9,  "Max Streak Pts", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 9,  totalCnt == 0 ? "-" : "+" + str.tostring(mxWPts, "#.#") + "p · " + str.tostring(mxLPts, "#.#") + "p",
                   text_color=lxAmber,  text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 10, "Streak",     text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 10, strkStr,       text_color=strkCol,  text_size=size.small,  bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 11, "SL",    text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 11, "ATR(" + str.tostring(atrLen) + ") × " + str.tostring(atrMult, "#.##"),
                   text_color=lxRed,    text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 12, "TP",    text_color=lxMuted,  text_size=size.tiny,   bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 12, "R:R 1:" + str.tostring(rrRatio, "#.##"),
                   text_color=lxGreen,  text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
        table.cell(statsTable, 0, 13, "Session · Risk", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(statsTable, 1, 13, sessTime + "  ·  $" + str.tostring(riskUSD, "#"),
                   text_color=lxText,   text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
        table.cell(statsTable, 0, 14, "Open", text_color=lxDimTx, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(statsTable, 1, 14, inTrade ? (posIsBuy ? "LONG" : "SHORT") + " @ " + str.tostring(posEntry, format.mintick) : "-",
                   text_color=inTrade ? lxAmber : lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
        if not mg1
            mg1 := true
            table.merge_cells(statsTable, 0, 0, 1, 0)
            table.merge_cells(statsTable, 0, 1, 1, 1)

    // ---- TABLE: BY-DAY (Sun–Sat) ----
    if showDayTable
        table.cell(dayStatsTbl, 0, 0, "◆  BY DAY  ·  " + periodStr, text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
        table.cell(dayStatsTbl, 0, 1, "DAY",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTbl, 1, 1, "W-L",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTbl, 2, 1, "WR%",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTbl, 3, 1, "NET R", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)

        bool[] showDayArr = array.from(showSun, showMon, showTue, showWed, showThu, showFri, showSat)
        int   bestDow = 0
        float bestNR  = 0.0
        for bd = 0 to 6
            int bDow = bd + 1
            if array.get(showDayArr, bd) and (array.get(dowWin, bDow) + array.get(dowLoss, bDow)) > 0 and array.get(dowNetR, bDow) > bestNR
                bestNR  := array.get(dowNetR, bDow)
                bestDow := bDow
        int   sumW   = 0
        int   sumL   = 0
        float sumR   = 0.0
        int   rowIdx = 2
        for d = 0 to 6
            int dw2 = d + 1
            if array.get(showDayArr, d)
                int   dwc  = array.get(dowWin,  dw2)
                int   dlc  = array.get(dowLoss, dw2)
                float dnr  = array.get(dowNetR, dw2)
                int   dtot = dwc + dlc
                float dwr  = dtot > 0 ? (dwc / dtot) * 100.0 : na
                color dwrC = na(dwr) ? lxDimTx : dwr >= 50 ? lxGreen : lxAmber
                color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
                string dNm = d == 0 ? "Sun" : d == 1 ? "Mon" : d == 2 ? "Tue" : d == 3 ? "Wed" : d == 4 ? "Thu" : d == 5 ? "Fri" : "Sat"
                bool isBest = dw2 == bestDow and dtot > 0
                color rowBg = isBest ? lxBestBg : rowIdx % 2 == 0 ? lxRowA : lxRowB
                table.cell(dayStatsTbl, 0, rowIdx, (isBest ? "★ " : "") + dNm,
                           text_color=isBest ? lxTitleTx : dtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=rowBg, text_halign=text.align_left)
                table.cell(dayStatsTbl, 1, rowIdx, dtot == 0 ? "-" : str.tostring(dwc) + "W · " + str.tostring(dlc) + "L",
                           text_color=dtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTbl, 2, rowIdx, na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%",
                           text_color=dwrC, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTbl, 3, rowIdx, dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R",
                           text_color=dnrC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_right)
                sumW   += dwc
                sumL   += dlc
                sumR   += dnr
                rowIdx += 1
        int   sumTot = sumW + sumL
        float sumWR  = sumTot > 0 ? (sumW / sumTot) * 100.0 : na
        table.cell(dayStatsTbl, 0, rowIdx, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
        table.cell(dayStatsTbl, 1, rowIdx, sumTot == 0 ? "-" : str.tostring(sumW) + "W · " + str.tostring(sumL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTbl, 2, rowIdx, na(sumWR) ? "-" : str.tostring(sumWR, "#.#") + "%", text_color=na(sumWR) ? lxDimTx : sumWR >= 50 ? lxGreen : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTbl, 3, rowIdx, sumTot == 0 ? "-" : (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + "R",
                   text_color=sumTot == 0 ? lxDimTx : sumR > 0 ? lxGreen : sumR < 0 ? lxRed : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
        if not mg2
            mg2 := true
            table.merge_cells(dayStatsTbl, 0, 0, 3, 0)

// ==========================================
// --- 16. TABLE: DAILY LOG (Specific Month) ---
// ==========================================

if showDailyTable and barstate.islast
    int[]    ddWin     = array.new_int(32, 0)
    int[]    ddLoss    = array.new_int(32, 0)
    float[]  ddNetR    = array.new_float(32, 0.0)
    float[]  ddWinPts  = array.new_float(32, 0.0)
    float[]  ddLossPts = array.new_float(32, 0.0)
    string[] ddTradeS  = array.new_string(32, "")

    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, k)
            if month(t,tzStr) == targetMonthNum and year(t,tzStr) == actualTargetY
                int   d     = dayofmonth(t, tzStr)
                bool  isWin = array.get(resIsWin,   k)
                float rrv   = array.get(resTradeRR, k)
                float pts   = array.get(resTpPts,   k)
                if d >= 1 and d <= 31
                    if isWin
                        array.set(ddWin,    d, array.get(ddWin,    d) + 1)
                        array.set(ddWinPts, d, array.get(ddWinPts, d) + pts)
                    else
                        array.set(ddLoss,    d, array.get(ddLoss,    d) + 1)
                        array.set(ddLossPts, d, array.get(ddLossPts, d) + pts)
                    array.set(ddNetR, d, array.get(ddNetR, d) + rrv)
                    string rSign = rrv >= 0 ? "+" : ""
                    array.set(ddTradeS, d, array.get(ddTradeS, d) + "Trade " + str.tostring(pts, "#.#") + "p " + rSign + str.tostring(rrv, "#.##") + "R\n")

    table.cell(dailyStatsTbl, 0, 0, "◆  DAILY LOG  ·  " + statTargetM + " " + str.tostring(actualTargetY), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(dailyStatsTbl, 0, 1, "DATE",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTbl, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTbl, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTbl, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTbl, 4, 1, "PTS",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTbl, 5, 1, "TRADES", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int   totW   = 0
    int   totL   = 0
    float totR   = 0.0
    float totWP  = 0.0
    float totLP  = 0.0
    for d = 1 to 31
        int   dw3  = array.get(ddWin,    d)
        int   dl3  = array.get(ddLoss,   d)
        float dnr  = array.get(ddNetR,   d)
        float dwp  = array.get(ddWinPts, d)
        float dlp  = array.get(ddLossPts,d)
        int   dtot = dw3 + dl3
        float dwr  = dtot > 0 ? (dw3 / dtot) * 100.0 : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
        string ts  = array.get(ddTradeS, d)
        if str.length(ts) > 0
            ts := str.substring(ts, 0, str.length(ts) - 1)
        color dayBg = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC = dtot == 0 ? lxDimTx  : lxText
        string dpipS = dtot == 0 ? "-" : "+" + str.tostring(dwp, "#.#") + " / -" + str.tostring(dlp, "#.#")
        color  dpipC = dtot == 0 ? lxDimTx : (dwp - dlp) > 0 ? lxGreen : (dwp - dlp) < 0 ? lxRed : lxAmber
        table.cell(dailyStatsTbl, 0, d+1, str.tostring(d),                     text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTbl, 1, d+1, dtot==0?"-":str.tostring(dw3)+"W · "+str.tostring(dl3)+"L", text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTbl, 2, d+1, na(dwr)?"-":str.tostring(dwr,"#.#")+"%",               text_color=dwrC,  text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTbl, 3, d+1, dtot==0?"-":(dnr>=0?"+":"")+str.tostring(dnr,"#.##")+"R", text_color=dnrC, text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTbl, 4, d+1, dpipS,                                text_color=dpipC, text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTbl, 5, d+1, ts,                                   text_color=color.new(lxText,22), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_left)
        totW += dw3
        totL += dl3
        totR += dnr
        totWP += dwp
        totLP += dlp
    int   totTot = totW + totL
    float totWR  = totTot > 0 ? (totW / totTot) * 100.0 : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    color totNRC = totTot == 0 ? lxDimTx : totR > 0 ? lxGreen : totR < 0 ? lxRed : lxAmber
    string totPipS = totTot == 0 ? "-" : "+" + str.tostring(totWP,"#.#") + " / -" + str.tostring(totLP,"#.#")
    color  totPipC = totTot == 0 ? lxDimTx : (totWP - totLP) > 0 ? lxGreen : (totWP - totLP) < 0 ? lxRed : lxAmber
    table.cell(dailyStatsTbl, 0, 33, "TOTAL",  text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(dailyStatsTbl, 1, 33, totTot==0?"-":str.tostring(totW)+"W · "+str.tostring(totL)+"L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTbl, 2, 33, na(totWR)?"-":str.tostring(totWR,"#.#")+"%",                    text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTbl, 3, 33, totTot==0?"-":(totR>=0?"+":"")+str.tostring(totR,"#.##")+"R",   text_color=totNRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTbl, 4, 33, totPipS,  text_color=totPipC,   text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTbl, 5, 33, na(totWR) ? "" : f_wrBar(totWR), text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    if not mg3
        mg3 := true
        table.merge_cells(dailyStatsTbl, 0, 0, 5, 0)

// ==========================================
// --- 17. TABLE: MONTHLY SUMMARY ---
// ==========================================

if showMonthlyTable and barstate.islast and statMode == "2. Last N Months"
    int startTotalM = currentTotalM - statMonths + 1
    int[]   mWin  = array.new_int(statMonths, 0)
    int[]   mLoss = array.new_int(statMonths, 0)
    float[] mNetR = array.new_float(statMonths, 0.0)
    int[]   mMaxW = array.new_int(statMonths, 0)
    int[]   mMaxL = array.new_int(statMonths, 0)
    int[]   mStrk = array.new_int(statMonths, 0)

    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tTM = year(t,tzStr) * 12 + month(t,tzStr)
            int idx = tTM - startTotalM
            if idx >= 0 and idx < statMonths
                float rrv   = array.get(resTradeRR, i)
                bool  isWin = array.get(resIsWin,   i)
                int   cs    = array.get(mStrk, idx)
                if isWin
                    array.set(mWin,  idx, array.get(mWin, idx) + 1)
                    cs := cs >= 0 ? cs + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), cs))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    cs := cs <= 0 ? cs - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -cs))
                array.set(mStrk, idx, cs)
                array.set(mNetR, idx, array.get(mNetR, idx) + rrv)

    table.cell(monthlyTbl, 0, 0, "◆  MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(monthlyTbl, 0, 1, "MONTH",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyTbl, 1, 1, "W-L",     text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyTbl, 2, 1, "WR%",     text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyTbl, 3, 1, "NET R",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyTbl, 4, 1, "STREAK",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)

    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin,m) + array.get(mLoss,m)) > 0 and array.get(mNetR,m) > bestMNR
            bestMNR  := array.get(mNetR,m)
            bestMIdx := m

    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    for m = 0 to statMonths - 1
        int   tM    = startTotalM + m
        int   mMon  = (tM - 1) % 12 + 1
        int   mYr   = math.round((tM - mMon) / 12)
        string mLbl = f_monthShort(mMon) + " " + str.tostring(mYr)
        int   mw    = array.get(mWin,  m)
        int   ml    = array.get(mLoss, m)
        float mnr   = array.get(mNetR, m)
        int   mtot  = mw + ml
        float mwr   = mtot > 0 ? (mw * 1.0 / mtot) * 100.0 : na
        bool isBestM = m == bestMIdx and mtot > 0
        color mRowBg = isBestM ? lxBestBg : m % 2 == 0 ? lxRowA : lxRowB
        color mwrC   = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        color mnrC   = mtot == 0 ? lxDimTx : mnr > 0 ? lxGreen : mnr < 0 ? lxRed : lxAmber
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        table.cell(monthlyTbl, 0, m+2, (isBestM?"★ ":"") + mLbl, text_color=isBestM?lxTitleTx:mtot==0?lxDimTx:lxText, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_left)
        table.cell(monthlyTbl, 1, m+2, mtot==0?"-":str.tostring(mw)+"W · "+str.tostring(ml)+"L", text_color=mtot==0?lxDimTx:lxText, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyTbl, 2, m+2, na(mwr)?"-":str.tostring(mwr,"#.#")+"%", text_color=mwrC, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyTbl, 3, m+2, mtot==0?"-":(mnr>=0?"+":"")+str.tostring(mnr,"#.##")+"R", text_color=mnrC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_right)
        table.cell(monthlyTbl, 4, m+2, mtot==0?"-":"W"+str.tostring(mmxW)+" · L"+str.tostring(mmxL), text_color=mtot==0?lxDimTx:lxAmber, text_size=size.small, bgcolor=mRowBg)
        mSumW += mw
        mSumL += ml
        mSumR += mnr

    int   mTot  = mSumW + mSumL
    float mWR   = mTot > 0 ? (mSumW * 1.0 / mTot) * 100.0 : na
    int   allMxW = 0
    int   allMxL = 0
    for sm = 0 to statMonths - 1
        allMxW := math.max(allMxW, array.get(mMaxW, sm))
        allMxL := math.max(allMxL, array.get(mMaxL, sm))
    int totalRow = statMonths + 2
    table.cell(monthlyTbl, 0, totalRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(monthlyTbl, 1, totalRow, mTot==0?"-":str.tostring(mSumW)+"W · "+str.tostring(mSumL)+"L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyTbl, 2, totalRow, na(mWR)?"-":str.tostring(mWR,"#.#")+"%", text_color=na(mWR)?lxDimTx:mWR>=50?lxGreen:lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyTbl, 3, totalRow, mTot==0?"-":(mSumR>=0?"+":"")+str.tostring(mSumR,"#.##")+"R", text_color=mTot==0?lxDimTx:mSumR>0?lxGreen:mSumR<0?lxRed:lxAmber, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(monthlyTbl, 4, totalRow, mTot==0?"-":"W"+str.tostring(allMxW)+" · L"+str.tostring(allMxL), text_color=mTot==0?lxDimTx:lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    if not mg4
        mg4 := true
        table.merge_cells(monthlyTbl, 0, 0, 4, 0)

// ==========================================
// --- 18. TABLE: SETTINGS SUMMARY ---
// ==========================================

if showSettingsTable and barstate.islast
    table.clear(settingsTbl, 0, 0, 1, 21)
    int ri = 0

    string daysStr = ""
    bool[] trArr = array.from(tSun, tMon, tTue, tWed, tThu, tFri, tSat)
    string[] dNms = array.from("Sun","Mon","Tue","Wed","Thu","Fri","Sat")
    for d = 0 to 6
        if array.get(trArr, d)
            daysStr += (str.length(daysStr) > 0 ? "," : "") + array.get(dNms, d)
    if str.length(daysStr) == 0
        daysStr := "none"

    color rowBg = lxRowA

    table.cell(settingsTbl, 0, ri, "◆  SETTINGS SUMMARY", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(settingsTbl, 1, ri, "",                    text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    ri += 1

    // Statistical Model section
    table.cell(settingsTbl, 0, ri, "─── Statistical Model ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "",                           text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Mode", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, entryModeStat, text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Center · σ Len", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, (useVWAPanchor ? "VWAP (daily)" : "SMA") + " · " + str.tostring(sdLen),
               text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Entry Z", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, entryModeStat == "Mean-Reversion" ? "±" + str.tostring(entryZ, "#.#") + "σ (reversion)"
               : "±" + str.tostring(brkZ, "#.#") + "σ · σ×" + str.tostring(volExpand, "#.##"),
               text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1

    // Session section
    table.cell(settingsTbl, 0, ri, "─── Session / Days ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "",                        text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Session", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, sessTime, text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "1/Day · EOD", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, (oneTradeDay ? "ON" : "off") + " · " + (closeEOD ? "ON" : "off"),
               text_color=(oneTradeDay or closeEOD) ? lxCyan : lxDimTx, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Trade Days", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, daysStr, text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Timezone", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, tzStr, text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1

    // Risk / Exit section
    table.cell(settingsTbl, 0, ri, "─── Risk / Exit ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "",                     text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "SL", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "ATR(" + str.tostring(atrLen) + ") × " + str.tostring(atrMult, "#.##"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "TP", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "R:R 1:" + str.tostring(rrRatio, "#.##"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Risk / 1R", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "$" + str.tostring(riskUSD, "#"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Lot Ratio", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, str.tostring(lotRatio, "#.###"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "LTF Check", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, ltfRes, text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1

    // Stat period
    table.cell(settingsTbl, 0, ri, "─── Stats Period ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, "",                      text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    ri += 1
    rowBg := ri % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTbl, 0, ri, "Period", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTbl, 1, ri, periodStr, text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    ri += 1

    if not mg5
        mg5 := true
        table.merge_cells(settingsTbl, 0, 0, 1, 0)

// ==========================================
// --- 19. ALERTS ---
// ==========================================

alertcondition(rawLong,  title="Stat LONG signal",  message="Stat Day-Trade: LONG signal")
alertcondition(rawShort, title="Stat SHORT signal", message="Stat Day-Trade: SHORT signal")
